# Review template only. Include under nginx's http context after checking
# existing vhosts, certificates, renewal method, and the owner-chosen hostname.
server {
    listen 443 ssl;
    server_name relay.example.org;

    ssl_certificate /etc/letsencrypt/live/relay.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.org/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # The pairing URL is a secret; neither this proxy nor the app logs URLs,
    # cookies, request bodies, or panel responses.
    access_log off;
    error_log /dev/null crit;

    if ($http_host != "relay.example.org") { return 421; }
    client_max_body_size 128m;
    client_body_timeout 120s;
    send_timeout 120s;

    location / {
        proxy_pass https://127.0.0.1:27443;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_redirect off;

        # Do not write uploads/downloads to nginx temporary files.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;

        proxy_ssl_server_name on;
        proxy_ssl_name relay.example.org;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3h5m;
        proxy_read_timeout 3h5m;
    }
}
